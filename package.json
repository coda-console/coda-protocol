{
  "name": "@coda-console/protocol",
  "version": "6.29.0",
  "description": "Coda 的协议：插件清单的类型（JSON Schema）、通用校验器、协议定义与调用信封、流程方言与 Agent 接入协议",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coda-console/coda-protocol.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "schemas",
    "validate.mjs",
    "agent.mjs",
    "workflow",
    "workflow.mjs",
    "docs",
    "protocol.mjs",
    "resource-protocol.mjs",
    "frames.mjs",
    "blob.mjs",
    "accord.mjs",
    "accord.d.mts",
    "vectors",
    "plugin.d.mts",
    "CHANGELOG.md",
    "stable"
  ],
  "exports": {
    "./validate": "./validate.mjs",
    "./workflow": "./workflow.mjs",
    "./schemas/*": "./schemas/*",
    "./workflow/*": "./workflow/*",
    "./docs/*": "./docs/*",
    "./package.json": "./package.json",
    "./agent": "./agent.mjs",
    "./protocol": "./protocol.mjs",
    "./frames": "./frames.mjs",
    "./blob": "./blob.mjs",
    "./accord": {
      "types": "./accord.d.mts",
      "default": "./accord.mjs"
    },
    "./vectors/accord.json": "./vectors/accord.json",
    "./types": "./plugin.d.mts",
    "./stable/*": "./stable/*"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@0dep/piso": "5.2.0",
    "ajv": "8.20.0",
    "bpmn-moddle": "10.3.1",
    "feelin": "8.2.0"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'"
  }
}
