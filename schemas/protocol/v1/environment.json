{
  "name": "coda/environment@1",
  "title": "环境",
  "description": "插件提供的外部环境，例如别家 Agent 自带的云主机。本版本只读：list 列目录，read 读文件；路径是 Provider 自己的命名空间。",
  "spec": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {"type": "string", "maxLength": 200, "description": "给人看的名字"},
      "container": {
        "type": "object",
        "description": "Provider 给的容器",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 2048},
          "title": {"type": "string", "maxLength": 200}
        },
        "required": ["id", "title"],
        "additionalProperties": false
      },
      "actions": {
        "type": "array",
        "uniqueItems": true,
        "items": {"enum": ["read", "checkout", "delete", "exec"]},
        "description": "能做什么；本版本只认 read"
      }
    },
    "required": ["title", "actions"],
    "additionalProperties": false
  },
  "status": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "state": {"enum": ["available", "unreachable"]},
      "reason": {"type": "string", "maxLength": 4096, "description": "状态说明，可选"}
    },
    "required": ["state"],
    "additionalProperties": false
  },
  "operations": {
    "list": {
      "description": "列目录：path 为空字符串表示根，after 是上一页的 next；立即结果。",
      "safe": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {"type": "string", "maxLength": 4096},
          "after": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string", "minLength": 1, "maxLength": 1024},
                "type": {"enum": ["file", "dir", "link"]},
                "size": {"type": "integer", "minimum": 0}
              },
              "required": ["name", "type"],
              "additionalProperties": false
            }
          },
          "next": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}], "description": "下一页从哪里接着列；没有了为 null"}
        },
        "required": ["entries", "next"],
        "additionalProperties": false
      }
    },
    "read": {
      "description": "读文件的一段：offset 默认 0，length 至多 1 MiB；立即结果。",
      "safe": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "offset": {"type": "integer", "minimum": 0},
          "length": {"type": "integer", "minimum": 0, "maximum": 1048576}
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "size": {"type": "integer", "minimum": 0, "description": "文件总字节数"},
          "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$", "description": "这一段的内容"},
          "more": {"type": "boolean", "description": "这一段之后还有没有"}
        },
        "required": ["path", "size", "base64", "more"],
        "additionalProperties": false
      }
    }
  }
}
