{
  "name": "coda/executor@1",
  "title": "执行器",
  "description": "一台机器上执行脚本步骤的环境。execute 接下一份工作，返回执行器自己开出的 coda/run@1 运行引用；执行器不写调用方的记录，也没有 target 绑定。",
  "spec": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "$defs": {
      "resourceName": {
        "type": "string",
        "pattern": "^(?:slots|group:(?!host$(?![\\s\\S]))[^\\s\\u0000-\\u001f\\u007f]{1,100})$(?![\\s\\S])",
        "description": "slots 对应 host；其他本机命名组用 group:<原名>，不将不同组折叠为 slots"
      },
      "resourceAmounts": {
        "type": "object",
        "propertyNames": {"$ref": "#/$defs/resourceName"},
        "maxProperties": 128,
        "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "description": "可报告多个独立资源的容量"
      },
      "userLabels": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])",
          "not": {
            "pattern": "^(darwin|linux|win32|aix|android|freebsd|openbsd|sunos|cygwin|netbsd|haiku|arm|arm64|ia32|x64|loong64|mips|mipsel|ppc|ppc64|riscv64|s390|s390x|gui)$|^(xcode|ios|node)-"
          }
        },
        "maxItems": 64,
        "uniqueItems": true,
        "description": "用户自定义标签，不占用 OS、架构、gui 与 xcode-/ios-/node- 探测命名空间"
      }
    },
    "properties": {
      "enabled": {"type": "boolean"},
      "capacity": {"$ref": "#/$defs/resourceAmounts"},
      "labels": {"$ref": "#/$defs/userLabels"},
      "title": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "required": ["enabled", "capacity", "labels"],
    "additionalProperties": false,
    "description": "执行器配置意图，由持有端维护"
  },
  "status": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "$defs": {
      "resourceName": {
        "type": "string",
        "pattern": "^(?:slots|group:(?!host$(?![\\s\\S]))[^\\s\\u0000-\\u001f\\u007f]{1,100})$(?![\\s\\S])"
      },
      "resourceAmounts": {
        "type": "object",
        "propertyNames": {"$ref": "#/$defs/resourceName"},
        "maxProperties": 128,
        "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "labels": {
        "type": "array",
        "items": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])"},
        "maxItems": 64,
        "uniqueItems": true
      },
      "reason": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "minLength": 1, "maxLength": 128},
          "message": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "timestamp": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?Z$(?![\\s\\S])"
      }
    },
    "properties": {
      "detectedLabels": {"$ref": "#/$defs/labels"},
      "capabilities": {
        "type": "object",
        "properties": {
          "os": {"type": "string", "minLength": 1, "maxLength": 40},
          "arch": {"type": "string", "minLength": 1, "maxLength": 40},
          "nodeVersion": {"type": "string", "minLength": 1, "maxLength": 128},
          "xcode": {
            "type": "object",
            "properties": {"version": {"type": "string", "minLength": 1, "maxLength": 128}, "build": {"type": "string", "minLength": 1, "maxLength": 128}},
            "required": ["version", "build"],
            "additionalProperties": false
          },
          "simulatorRuntimes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "version": {"type": "string", "minLength": 1, "maxLength": 128}, "available": {"type": "boolean"}},
              "required": ["id", "version", "available"],
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "graphicalSession": {"type": ["boolean", "null"]}
        },
        "required": ["os", "arch", "nodeVersion", "graphicalSession"],
        "additionalProperties": false
      },
      "capacity": {"$ref": "#/$defs/resourceAmounts"},
      "occupied": {"$ref": "#/$defs/resourceAmounts"},
      "available": {"$ref": "#/$defs/resourceAmounts"},
      "accepting": {"type": "boolean"},
      "reason": {"$ref": "#/$defs/reason"},
      "observedAt": {"$ref": "#/$defs/timestamp"},
      "observedRevision": {"type": "string", "minLength": 1, "maxLength": 2048},
      "executionFeatures": {
        "type": "object",
        "properties": {
          "multiResource": {"const": false},
          "multiUnit": {"const": false},
          "exclusive": {"type": "boolean"},
          "noResources": {"type": "boolean"},
          "namedResources": {"type": "boolean"},
          "context": {"type": "boolean"}
        },
        "required": ["multiResource", "multiUnit", "exclusive"],
        "additionalProperties": false
      }
    },
    "required": [],
    "additionalProperties": false,
    "anyOf": [
      {"maxProperties": 0},
      {
        "required": ["detectedLabels", "capabilities", "capacity", "occupied", "available", "accepting", "observedAt", "observedRevision", "executionFeatures"]
      }
    ],
    "description": "空对象表示未知；非空为持有端最近观察到的事实，不是在线或预留保证"
  },
  "operations": {
    "execute": {
      "description": "接下一份执行工作，返回执行器自己开出的运行引用。",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "$defs": {
          "opaqueId": {"type": "string", "minLength": 1, "maxLength": 2048},
          "resourceRef": {
            "type": "object",
            "properties": {"kind": {"type": "string", "minLength": 1, "maxLength": 128}, "id": {"$ref": "#/$defs/opaqueId"}},
            "required": ["kind", "id"],
            "additionalProperties": false
          },
          "snapshotRef": {
            "type": "object",
            "properties": {"kind": {"const": "git/snapshot@1"}, "id": {"$ref": "#/$defs/opaqueId"}},
            "required": ["kind", "id"],
            "additionalProperties": false
          },
          "repositoryRef": {
            "type": "object",
            "properties": {"kind": {"const": "git/source@1"}, "id": {"$ref": "#/$defs/opaqueId"}},
            "required": ["kind", "id"],
            "additionalProperties": false
          },
          "labels": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])"},
            "maxItems": 64,
            "uniqueItems": true
          },
          "resourceName": {
            "type": "string",
            "pattern": "^(?:slots|group:(?!host$(?![\\s\\S]))[^\\s\\u0000-\\u001f\\u007f]{1,100})$(?![\\s\\S])"
          },
          "workingDirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "description": "工作根下的相对路径；拒绝绝对路径、反斜线和 .. 段，真实落点与符号链接仍须执行方检查"
          }
        },
        "properties": {
          "source": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "properties": {"snapshot": {"$ref": "#/$defs/snapshotRef"}}, "required": ["snapshot"], "additionalProperties": false},
              {
                "type": "object",
                "properties": {
                  "repository": {"$ref": "#/$defs/repositoryRef"},
                  "commit": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$(?![\\s\\S])"}
                },
                "required": ["repository", "commit"],
                "additionalProperties": false
              }
            ]
          },
          "requirements": {
            "type": "object",
            "properties": {"labels": {"$ref": "#/$defs/labels"}},
            "required": ["labels"],
            "additionalProperties": false
          },
          "resources": {
            "type": "object",
            "propertyNames": {"$ref": "#/$defs/resourceName"},
            "maxProperties": 1,
            "additionalProperties": {"const": 1},
            "description": "空对象表示不占资源；否则只申请一个资源的一单位"
          },
          "exclusiveResources": {
            "type": "array",
            "items": {"$ref": "#/$defs/resourceName"},
            "maxItems": 1,
            "uniqueItems": true,
            "default": [],
            "description": "空数组或独占申请的那一个资源，须与 resources 的键一致"
          },
          "context": {
            "type": "object",
            "properties": {
              "workflow": {
                "type": "object",
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 256},
                  "job": {"type": "string", "minLength": 1, "maxLength": 256},
                  "runId": {"$ref": "#/$defs/opaqueId"},
                  "runAttempt": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
                  "sha": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})?$(?![\\s\\S])"},
                  "ref": {"type": "string", "maxLength": 1024},
                  "repository": {"type": "string", "maxLength": 2048}
                },
                "required": ["name", "job", "runId", "runAttempt", "sha", "ref", "repository"],
                "additionalProperties": false
              },
              "plugin": {
                "type": "object",
                "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$(?![\\s\\S])"}, "version": {"type": "string", "minLength": 1, "maxLength": 128}},
                "required": ["id", "version"],
                "additionalProperties": false
              },
              "audience": {"const": "user"},
              "outputNames": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
            },
            "additionalProperties": false,
            "description": "可信生产者给出的运行上下文与输出声明；不是环境快照或授权凭证"
          },
          "task": {
            "oneOf": [
              {"type": "object", "properties": {"script": {"type": "string", "minLength": 1, "maxLength": 65536}, "shell": {"type": "string", "minLength": 1, "maxLength": 4096}}, "required": ["script", "shell"], "additionalProperties": false},
              {"type": "object", "properties": {"command": {"type": "string", "minLength": 1, "maxLength": 4096}, "args": {"type": "array", "items": {"type": "string", "minLength": 0, "maxLength": 16384}, "maxItems": 256}}, "required": ["command", "args"], "additionalProperties": false}
            ]
          },
          "workingDirectory": {"$ref": "#/$defs/workingDirectory", "default": "."},
          "env": {
            "type": "object",
            "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$(?![\\s\\S])"},
            "maxProperties": 128,
            "additionalProperties": {"type": "string", "minLength": 0, "maxLength": 16384}
          },
          "timeoutMs": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
          "cancelGraceMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
        },
        "required": ["source", "requirements", "resources", "task", "env"],
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"resources": {"maxProperties": 0}}}, "then": {"properties": {"exclusiveResources": {"maxItems": 0}}}}
        ],
        "description": "一次执行工作的输入；取消走 coda/run@1 的 cancel 操作，不写在输入里"
      },
      "run": true
    }
  }
}
