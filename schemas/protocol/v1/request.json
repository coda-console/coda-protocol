{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/protocol/v1/request.json",
  "title": "统一调用请求",
  "description": "对一条记录的一次操作：记录引用、操作名、输入、请求 ID、发起方引用和是否被等待。同一个请求 ID 重发只做一次；被调用方建运行时照抄 parent 与 awaited。",
  "type": "object",
  "$defs": {
    "reference": {
      "description": "记录引用：协议名（尚未定义成协议的资源暂用资源种类名）与不透明 ID",
      "type": "object",
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 128},
        "id": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    }
  },
  "properties": {
    "record": {"$ref": "#/$defs/reference"},
    "operation": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "input": true,
    "requestId": {"type": "string", "minLength": 1, "maxLength": 2048},
    "parent": {"$ref": "#/$defs/reference", "description": "发起这次调用的一方：调用方的运行、会话或其他记录"},
    "awaited": {"type": "boolean", "description": "调用方是否在等它"}
  },
  "required": ["record", "operation", "input", "requestId", "parent", "awaited"],
  "additionalProperties": false
}
