{
  "name": "coda/session@1",
  "title": "会话",
  "description": "插件提供的外部会话：参与者、消息、草稿与发消息。Provider 每追加一条消息就推进 status.head，观察方 watch 记录后用 read 读游标之后的消息；撤回、编辑、表情回应都是一条用 about 指向旧消息的新消息。",
  "spec": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {"type": "string", "maxLength": 200, "description": "给人看的名字"},
      "container": {
        "type": "object",
        "description": "Provider 给的容器，例如插件登录的微信号；列表按 provider 与 container.id 分组",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 2048},
          "title": {"type": "string", "maxLength": 200}
        },
        "required": ["id", "title"],
        "additionalProperties": false
      },
      "environment": {
        "type": "object",
        "description": "外部会话自带的环境",
        "properties": {
          "kind": {"const": "coda/environment@1"},
          "id": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "required": ["kind", "id"],
        "additionalProperties": false
      }
    },
    "required": ["title", "container"],
    "additionalProperties": false
  },
  "status": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "head": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "最新一条消息的游标，不透明；Provider 每追加一条就写，还没有消息时不写"},
      "participants": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 2048},
            "name": {"type": "string", "maxLength": 200},
            "kind": {"enum": ["person", "agent", "bot"]},
            "self": {"const": true, "description": "这个 Provider 登录的账号，即 Coda 的 Bot"}
          },
          "required": ["id", "name", "kind"],
          "additionalProperties": false
        }
      },
      "state": {"enum": ["active", "unreachable"]},
      "reason": {"type": "string", "maxLength": 4096, "description": "状态说明，可选"},
      "accepts": {
        "type": "object",
        "description": "post 除文字以外还收哪些媒体 part，键是 part 的 type，值是这一类型的限制；不写就是只收文字。能力可能随状态变化，所以放在 status",
        "properties": {
          "image": {"type": "object", "additionalProperties": false},
          "video": {"type": "object", "additionalProperties": false},
          "file": {"type": "object", "additionalProperties": false},
          "audio": {
            "type": "object",
            "description": "收 upload 引用的语音",
            "properties": {"maxDuration": {"type": "number", "exclusiveMinimum": 0, "description": "一条语音最长多少秒"}},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "required": ["participants"],
    "additionalProperties": false
  },
  "operations": {
    "read": {
      "description": "读消息，limit 为 1 到 100，消息总按先后排（旧在前）；立即结果。都不带游标时读最新的 limit 条，more 表示更早还有没有；带 after 读这个游标之后的，more 表示之后还有没有；带 before 读这个游标之前最新的 limit 条，more 表示更早还有没有。after 与 before 不能同时带。",
      "safe": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "after": {"type": "string", "minLength": 1, "maxLength": 2048},
          "before": {"type": "string", "minLength": 1, "maxLength": 2048},
          "limit": {"type": "integer", "minimum": 1, "maximum": 100}
        },
        "not": {"required": ["after", "before"]},
        "additionalProperties": false
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "$defs": {
          "id": {"type": "string", "minLength": 1, "maxLength": 2048},
          "part": {
            "oneOf": [
              {
                "type": "object",
                "properties": {"type": {"const": "text"}, "text": {"type": "string"}},
                "required": ["type", "text"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {"enum": ["image", "video", "file", "audio"]},
                  "name": {"type": "string", "maxLength": 1024},
                  "size": {"type": "integer", "minimum": 0},
                  "mime": {"type": "string", "maxLength": 255},
                  "width": {"type": "integer", "minimum": 1, "description": "像素宽，已按拍摄方向转正；图片和视频用"},
                  "height": {"type": "integer", "minimum": 1, "description": "像素高，已按拍摄方向转正；图片和视频用"},
                  "duration": {"type": "number", "minimum": 0, "description": "时长，秒；视频和语音用"},
                  "thumb": {"type": "string", "maxLength": 8192, "description": "内嵌 JPEG 的 base64，不带 data: 前缀；自己生成时长边取 64 像素左右，已有的小缩略图在上限内可原样放；视频用封面帧"},
                  "service": {"type": "string", "minLength": 1, "maxLength": 200, "description": "provider 插件登记的本机流式服务 ID"},
                  "path": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "原文件的服务内路径，原样接在 /v1/plugins/<provider 插件>/services/<service>/ 之后"},
                  "preview": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "预览图在同一个 service 里的服务内路径：图片是长边一般不超过约 1280 像素的静图，视频是封面帧"}
                },
                "required": ["type", "name"],
                "dependentRequired": {"path": ["service"], "preview": ["service"]},
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"type": {"enum": ["thinking", "tool"]}, "text": {"type": "string"}},
                "required": ["type", "text"],
                "additionalProperties": false
              }
            ]
          },
          "message": {
            "type": "object",
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "cursor": {"$ref": "#/$defs/id"},
              "sender": {"$ref": "#/$defs/id", "description": "参与者 ID"},
              "senderName": {"type": "string", "maxLength": 200, "description": "发送者当时的显示名，可选；大群不必把每个发送者都写进 status.participants"},
              "text": {"type": "string", "description": "纯文本兜底"},
              "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
              "replyTo": {"$ref": "#/$defs/id", "description": "回复的消息 ID"},
              "mentions": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "@ 到的参与者 ID；回复一条消息就算 @ 了它的发送者，Provider 把被回复消息的发送者也写进来"},
              "about": {
                "type": "object",
                "description": "这条消息改的是哪条旧消息",
                "properties": {
                  "message": {"$ref": "#/$defs/id"},
                  "change": {"enum": ["edit", "recall", "reaction"]},
                  "value": {"description": "编辑后的内容或表情等，可选"}
                },
                "required": ["message", "change"],
                "additionalProperties": false
              },
              "createdAt": {"type": "string", "minLength": 1, "maxLength": 40, "description": "只供显示"}
            },
            "required": ["id", "cursor", "sender", "text"],
            "additionalProperties": false
          }
        },
        "properties": {
          "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
          "cursor": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}], "description": "下一次读从哪里接着读；没有消息时为 null"},
          "more": {"type": "boolean"}
        },
        "required": ["messages", "cursor", "more"],
        "additionalProperties": false
      }
    },
    "post": {
      "description": "以 self 发一条消息，开运行；重发同一个 requestId 得到同一个运行，只发一次。completed 的 result 是 { message: { id, cursor } }，即以后 read 读到的那条；failed 的 result 是 { code, message }，不确定发没发出去时 code 为 unknown，收到 status.accepts 没声明的媒体 part 或超出它的限制时 code 为 unsupported；不确定时调用方显示结果未知、不自动重发。还没开始发时取消得到 canceled，已开始的看 status。没先写草稿也照常发。",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "$defs": {
          "id": {"type": "string", "minLength": 1, "maxLength": 2048},
          "part": {
            "oneOf": [
              {
                "type": "object",
                "properties": {"type": {"const": "text"}, "text": {"type": "string"}},
                "required": ["type", "text"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {"enum": ["image", "video", "file", "audio"]},
                  "name": {"type": "string", "maxLength": 1024},
                  "size": {"type": "integer", "minimum": 0},
                  "mime": {"type": "string", "maxLength": 255},
                  "width": {"type": "integer", "minimum": 1, "description": "像素宽，已按拍摄方向转正；图片和视频用"},
                  "height": {"type": "integer", "minimum": 1, "description": "像素高，已按拍摄方向转正；图片和视频用"},
                  "duration": {"type": "number", "minimum": 0, "description": "时长，秒；视频和语音用"},
                  "thumb": {"type": "string", "maxLength": 8192, "description": "内嵌 JPEG 的 base64，不带 data: 前缀；自己生成时长边取 64 像素左右，已有的小缩略图在上限内可原样放；视频用封面帧"},
                  "service": {"type": "string", "minLength": 1, "maxLength": 200, "description": "provider 插件登记的本机流式服务 ID"},
                  "path": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "原文件的服务内路径，原样接在 /v1/plugins/<provider 插件>/services/<service>/ 之后"},
                  "preview": {"type": "string", "minLength": 1, "maxLength": 2048, "description": "预览图在同一个 service 里的服务内路径：图片是长边一般不超过约 1280 像素的静图，视频是封面帧"},
                  "upload": {"type": "string", "minLength": 1, "maxLength": 200, "description": "持有这条记录的机器上 Coda 上传的 ID（POST /v1/uploads 返回的）；与 service、path、preview 互斥"}
                },
                "required": ["type", "name"],
                "dependentRequired": {"path": ["service"], "preview": ["service"]},
                "dependentSchemas": {"upload": {"properties": {"service": false, "path": false, "preview": false}}},
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"type": {"enum": ["thinking", "tool"]}, "text": {"type": "string"}},
                "required": ["type", "text"],
                "additionalProperties": false
              }
            ]
          }
        },
        "properties": {
          "text": {"type": "string", "description": "纯文本兜底"},
          "parts": {"type": "array", "items": {"$ref": "#/$defs/part"}},
          "replyTo": {"$ref": "#/$defs/id", "description": "回复的消息 ID"},
          "mentions": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "@ 到的参与者 ID"}
        },
        "required": ["text"],
        "additionalProperties": false
      },
      "run": true
    },
    "draft": {
      "description": "设定 self 在这个会话里还没发出去的草稿，立即结果。text 是全文，空串为清空；version 只增，Provider 丢掉不大于已见最大版本的；steps 是从上一版到这一版的中间状态，可照 delayMs 回放，最后一步等于 text。用不上草稿的 Provider 直接答 {}。",
      "idempotent": true,
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "text": {"type": "string", "maxLength": 65536, "description": "草稿全文；空串表示清空或放弃"},
          "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "调用方给的版本号，比大小，后写的为准；建议用毫秒时间"},
          "steps": {
            "type": "array",
            "maxItems": 1000,
            "description": "从上一版到这一版的中间状态，按先后排；最后一步等于 text",
            "items": {
              "type": "object",
              "properties": {
                "text": {"type": "string", "maxLength": 65536, "description": "这一步的全文"},
                "delayMs": {"type": "integer", "minimum": 0, "maximum": 600000, "description": "距上一步的间隔（毫秒）"}
              },
              "required": ["text", "delayMs"],
              "additionalProperties": false
            }
          }
        },
        "required": ["text", "version"],
        "additionalProperties": false
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "maxProperties": 0
      }
    }
  }
}
