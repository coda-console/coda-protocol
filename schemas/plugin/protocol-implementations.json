{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v2/protocol-implementations.json",
  "title": "contributes.protocolImplementations：Coda 预定协议的实现",
  "description": "实现的协议类型、主版本与可选本机对象 ID；声明不定义类型，不覆盖协议自身的写入约束。宿主检查版本与实现范围冲突。",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9-]*$",
        "description": "Coda 已预定的协议类型名，不是插件 ID"
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "description": "协议主版本，须与宿主预定类型一致；不是 npm 包版本"
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!remote:)",
        "description": "可选的本机对象 ID；不写表示整个类型。不能声明镜像引用。"
      }
    },
    "required": [
      "kind",
      "version"
    ],
    "additionalProperties": false
  }
}
