{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v2/endpoints.json",
  "title": "contributes.endpoints：客户端发给插件的请求",
  "description": "id → 回答它的一行命令（请求从标准输入给）。",
  "type": "array",
  "maxItems": 20,
  "items": {
    "type": "object",
    "properties": {
      "id": {"$ref": "common.json#/$defs/id"},
      "command": {"$ref": "common.json#/$defs/command"}
    },
    "required": ["id", "command"],
    "additionalProperties": false
  },
  "x-unique-by": ["id"]
}
