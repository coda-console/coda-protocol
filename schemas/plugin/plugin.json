{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coda.pub/schemas/plugin/v2/plugin.json",
  "title": "插件清单（插件目录的 package.json）",
  "description": "照 VS Code 扩展的 package.json 写；Coda 读的是下面这些键，其余是 npm 的，不管。contributes 的每个键是一种类型，各有自己的 schema；不是 Coda 的键，是写给别的插件的扩展点的（它们声明的类型），由那个扩展点的 schema 校验。",
  "type": "object",
  "properties": {
    "id": {"$ref": "common.json#/$defs/id", "description": "插件 ID：小写字母、数字和「-」，以字母开头，至多 40 个字符；不写就用 name"},
    "name": {"type": "string"},
    "description": {"description": "一句话简介：插件列表里只显示一行，20 字以内为宜；更多的说明写在插件目录的 README.md，插件页里显示", "type": "string"},
    "icon": {
      "description": "插件的图标：插件目录里的 PDF（light 必填，dark 与 template 可选，同 Agent 的图标），或 SF Symbols 的符号画在系统色的底上（symbol 与 color）；客户端裁成圆角方块。不写时，只带一个 Agent 的插件用那个 Agent 的图标，其余用分类的默认图标",
      "type": "object",
      "if": {"required": ["symbol"]},
      "then": {"$ref": "#/$defs/symbolIcon"},
      "else": {"$ref": "#/$defs/fileIcon"}
    },
    "categories": {"description": "分类：文本的数组，第一个是插件页里归的类", "type": "array", "items": {"type": "string"}},
    "coda": {
      "description": "Coda 宿主的安装要求；不写 channels 就不限制后端通道",
      "type": "object",
      "properties": {
        "channels": {"description": "允许安装和更新的后端通道：stable（正式版）、preview（预览版）；以目标后端的安装记录为准，没有通道记录不满足限制", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["stable", "preview"]}}
      },
      "additionalProperties": false
    },
    "main": {"description": "插件宿主运行的模块：插件目录里的 .js 或 .mjs 文件", "type": "string", "pattern": "\\.m?js$", "x-file": {"type": "file"}},
    "activationEvents": {"description": "宿主什么时候加载 main：onStartupFinished（后端一启动），不重复", "type": "array", "items": {"enum": ["onStartupFinished"]}, "uniqueItems": true},
    "extensionDependencies": {"description": "需要先装的插件的 ID，不重复", "type": "array", "items": {"$ref": "common.json#/$defs/id"}, "uniqueItems": true},
    "contributes": {
      "description": "插件带来的东西：每个键一种类型",
      "type": "object",
      "properties": {
        "configuration": {"$ref": "configuration.json"},
        "capabilities": {"$ref": "capabilities.json"},
        "instructions": {"$ref": "instructions.json"},
        "agents": {"$ref": "agents.json"},
        "extensionPoints": {"$ref": "extension-points.json"},
        "extensions": {"$ref": "extensions.json"},
        "groups": {"$ref": "groups.json"},
        "events": {"$ref": "events.json"},
        "commands": {"$ref": "commands.json"},
        "gitCredentials": {"$ref": "git-credentials.json"},
        "repositories": {"$ref": "repositories.json"},
        "services": {"$ref": "services.json"},
        "setup": {"$ref": "setup.json"},
        "skills": {"$ref": "skills.json"},
        "environment": {"$ref": "environment.json"},
        "path": {"$ref": "path.json"},
        "endpoints": {"$ref": "endpoints.json"},
        "mcpServers": {"$ref": "mcp-servers.json"},
        "views": {"$ref": "views.json"},
        "modelProviders": {"$ref": "model-providers.json"},
        "executors": {"$ref": "executors.json"},
        "composerModes": {"$ref": "composer-modes.json"}
      },
      "propertyNames": {"description": "contributes 的键：字母和数字，以小写字母开头", "pattern": "^[a-z][A-Za-z0-9]{0,39}$"}
    }
  },
  "$defs": {
    "fileIcon": {
      "type": "object",
      "properties": {"light": {"$ref": "agents.json#/$defs/icon"}, "dark": {"$ref": "agents.json#/$defs/icon"}, "template": {"description": "单色图标：按文字颜色画", "type": "boolean"}},
      "required": ["light"],
      "additionalProperties": false
    },
    "symbolIcon": {
      "type": "object",
      "properties": {
        "symbol": {"description": "SF Symbols 的符号名，如 key.fill", "type": "string", "maxLength": 100, "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)*$"},
        "color": {"description": "底色：系统色 red、orange、yellow、green、mint、teal、cyan、blue、indigo、purple、pink、brown、gray 之一", "enum": ["red", "orange", "yellow", "green", "mint", "teal", "cyan", "blue", "indigo", "purple", "pink", "brown", "gray"]}
      },
      "required": ["symbol", "color"],
      "additionalProperties": false
    }
  },
  "if": {"properties": {"activationEvents": {"minItems": 1}}, "required": ["activationEvents"]},
  "then": {"required": ["main"], "description": "写了 activationEvents 的插件须有 main"}
}
